#!/bin/bash
source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"
source /usr/share/yunohost/helpers

ynh_script_progression --message="Refreshing source..."
btcpub_sync_source "$install_dir"
chown -R "$app:$app" "$install_dir"

mkdir -p "$data_dir" "/var/log/$app"
chown -R "$app:$app" "$data_dir" "/var/log/$app"
btcpub_seed_settings "$data_dir" "$app"

#=================================================
# REWRITE config.php (Telegram creds preserved in settings.json — untouched)
#=================================================
if [ -z "$node_onion" ]; then
    node_onion="127.0.0.1"
fi
public_fallback="$(btcpub_bool_to_php "$public_fallback")"
ynh_config_add --template="config.php" --destination="$install_dir/config.php"
chown "$app:$app" "$install_dir/config.php"
chmod 640 "$install_dir/config.php"

ynh_script_progression --message="Refreshing PHP-FPM, nginx, cron, logrotate..."
ynh_config_add_phpfpm
ynh_config_add_nginx
ynh_config_add --template="cron" --destination="/etc/cron.d/$app"
chown root:root "/etc/cron.d/$app"
chmod 644 "/etc/cron.d/$app"
ynh_config_add_logrotate "/var/log/$app"

ynh_script_progression --message="Refreshing Tor instance..."
btcpub_setup_tor_instance "$app"

ynh_script_progression --message="Upgrade completed"
